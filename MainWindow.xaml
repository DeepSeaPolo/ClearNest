<Window x:Class="ClearNest.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="ClearNest · 清巢" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="看清占用，再决定清理" Opacity="0.65"/></StackPanel><Button Content="迷你窗口 ↗" Click="Mini_Click" HorizontalAlignment="Right"/></Grid>
  <TabView Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False">
   <TabViewItem Header="内存" IsClosable="False"><ScrollViewer><StackPanel Spacing="16" Padding="12,20">
    <TextBlock x:Name="MemoryText" FontSize="24"/><ProgressBar x:Name="MemoryBar" Maximum="100"/>
    <TextBlock Text="待机缓存属于可用内存，Windows 会按需复用。手动回收可能降低后续启动速度，不保证性能提升。" TextWrapping="Wrap"/>
    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="仅回收待机页，不清空进程工作集，不处理修改页，不自动杀进程。使用非公开 Windows 接口，系统不支持时直接报错。"/>
    <Button Content="回收待机缓存（需要管理员）" Click="Memory_Click"/>
    <TextBlock Text="进程检查" FontSize="20"/><TextBlock Text="采样仅用于提示。无窗口、低 CPU 不代表无用，内存数据也不能直接相加。" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="扫描进程" Click="Processes_Click"/><Button Content="打开任务管理器" Click="TaskManager_Click"/></StackPanel>
    <ListView x:Name="Processes" Height="260" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView>
   </StackPanel></ScrollViewer></TabViewItem>
   <TabViewItem Header="C 盘清理" IsClosable="False"><Grid Padding="12,20" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="仅扫描 C 盘当前用户 Temp 和 Windows Temp，保留最近 7 天文件。跳过链接、受保护文件和占用文件。删除不可撤销，请核对路径。" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"><Button Content="扫描临时文件" Click="DiskScan_Click"/><Button Content="删除所选文件" Click="DiskClean_Click"/></StackPanel>
    <ListView x:Name="DiskList" Grid.Row="2" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView>
   </Grid></TabViewItem>
   <TabViewItem Header="注册表" IsClosable="False"><Grid Padding="12,20" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="仅检查当前用户 Run 启动项中，带引号的 C 盘 EXE 路径已不存在的条目。缺失也可能是临时状态，请人工核对。删除前自动备份；恢复不覆盖现有同名值。" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12"><Button Content="扫描启动项" Click="RegistryScan_Click"/><Button Content="备份并删除所选" Click="RegistryClean_Click"/><Button Content="选择备份恢复" Click="Restore_Click"/></StackPanel>
    <ListView x:Name="RegistryList" Grid.Row="2" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView>
   </Grid></TabViewItem>
   <TabViewItem Header="设置" IsClosable="False"><StackPanel Padding="12,20" Spacing="18"><ToggleSwitch x:Name="Resident" Header="后台常驻" OnContent="关闭主窗口后留在托盘" OffContent="关闭主窗口时退出" Toggled="Resident_Toggled"/><TextBlock Text="常驻时每 5 秒刷新内存，不自动清理。不添加开机启动项。托盘双击可恢复窗口。" TextWrapping="Wrap"/><Button Content="退出 ClearNest" Click="Exit_Click"/></StackPanel></TabViewItem>
  </TabView>
  <InfoBar x:Name="Status" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="就绪 · 清理项目默认不勾选"/>
 </Grid>
</Window>
