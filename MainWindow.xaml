<Window x:Class="ClearNest.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.Resources>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
  </Grid.Resources>
  <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="218" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" SelectionChanged="Navigation_SelectionChanged" Header="内存概览">
   <NavigationView.PaneHeader><StackPanel Margin="16,16,12,24" Spacing="4"><TextBlock Text="ClearNest" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="清巢 · 系统维护" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem Content="内存概览" Tag="memory"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="临时文件" Tag="disk"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="启动项检查" Tag="registry"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="应用设置" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE115;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter><Button Content="迷你模式" AutomationProperties.AutomationId="SwitchToMini" Click="Mini_Click" HorizontalAlignment="Stretch" Margin="12,12,12,24"/></NavigationView.PaneFooter>
   <Grid Margin="28,8,28,24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="MemoryPage" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" Padding="0,0,0,8">
     <TextBlock Text="查看当前内存状态，按需回收待机缓存。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="物理内存使用率" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="MemoryPercent" FontSize="56" FontWeight="SemiBold"/><ProgressBar x:Name="MemoryBar" Maximum="100"/><TextBlock x:Name="MemoryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="当前可用" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AvailableText" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="包含系统可按需复用的待机缓存" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="回收待机缓存" Style="{StaticResource AccentButtonStyle}" Click="Memory_Click"/></StackPanel></Border>
     </Grid>
     <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="让系统按需管理内存" Message="回收只处理未修改的待机页，不清空应用工作集。缓存本来就可用，清空可能增加磁盘读取；需要管理员权限。"/>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><Grid><StackPanel><TextBlock Text="进程占用" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="短时低 CPU 不代表无用，列表仅供人工检查。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="扫描进程" Click="Processes_Click"/><Button Content="任务管理器" Click="TaskManager_Click"/></StackPanel></Grid>
      <ListView x:Name="Processes" Height="250" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="DiskPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="清理超过 7 天未修改的 C 盘临时文件，先检查，再选择删除。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="临时文件检查" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="仅包含当前用户 Temp 与 Windows Temp。跳过链接、受保护及占用文件；删除不经过回收站。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="扫描临时文件" Style="{StaticResource AccentButtonStyle}" Click="DiskScan_Click"/><Button Content="删除所选" Click="DiskClean_Click"/></StackPanel></StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><ListView x:Name="DiskList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </Grid>
    <Grid x:Name="RegistryPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="检查当前用户中目标文件已不存在的启动项。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="启动项与备份" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="仅检查带引号的 C 盘 EXE 路径。文件缺失可能是临时状态，请核对后选择；删除前自动备份。恢复不会覆盖现有同名项。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="扫描启动项" Style="{StaticResource AccentButtonStyle}" Click="RegistryScan_Click"/><Button Content="备份并删除" Click="RegistryClean_Click"/><Button Content="从备份恢复" Click="Restore_Click"/></StackPanel></StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><ListView x:Name="RegistryList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border>
    </Grid>
    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="16"><TextBlock Text="设置窗口行为与后台运行方式。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Border Style="{StaticResource Card}"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="后台常驻" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="关闭窗口后留在托盘。双击托盘图标可返回主窗口。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="Resident" Grid.Column="1" AutomationProperties.Name="后台常驻" OnContent="开启" OffContent="关闭" Toggled="Resident_Toggled"/></Grid></Border>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="迷你模式" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="主窗口与迷你窗口互相切换，只显示其中一个。迷你模式下回收内存也不会唤出主窗口。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="切换到迷你窗口" Click="Mini_Click"/></StackPanel></Border>
     <Button Content="退出 ClearNest" Click="Exit_Click"/>
    </StackPanel>
    <InfoBar x:Name="Status" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Message="就绪 · 清理项目默认不勾选"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>