<Window x:Class="ClearNest.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.Resources>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
   <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Background" Value="{StaticResource AppAccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Grid.Resources>
  <Grid x:Name="TitleRegion" Background="Transparent" Padding="140,0,140,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{StaticResource AppAccentBrush}"/><TextBlock Text="ClearNest · 清巢" FontSize="13" VerticalAlignment="Center"/></StackPanel></Grid>
  <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="LeftCompact" CompactPaneLength="64" OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" Header="仪表盘">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="仪表盘" Tag="home" AutomationProperties.AutomationId="OpenHome"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="进程列表" Tag="process"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="临时文件" Tag="disk"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="启动项检查" Tag="registry"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Tag="settings" AutomationProperties.AutomationId="OpenSettings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE115;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
   <Grid Margin="24,4,24,20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="HomePage" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DashboardStack" Spacing="16" Padding="0,0,0,8" SizeChanged="Dashboard_SizeChanged">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="系统状态与清理" FontSize="16"/><TextBlock Text="查看状态，按需扫描，确认后清理。" Style="{StaticResource Secondary}"/></StackPanel><Button Grid.Column="1" Content="迷你模式" AutomationProperties.AutomationId="SwitchToMini" Click="Mini_Click" VerticalAlignment="Center"/></Grid>
     <Grid x:Name="MemoryCards" ColumnSpacing="16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="内存使用率" Style="{StaticResource Secondary}"/><TextBlock x:Name="MemoryPercent" FontSize="54" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}"/><ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource AppAccentBrush}"/><TextBlock x:Name="MemoryText" Style="{StaticResource Secondary}"/></StackPanel></Border>
      <Border x:Name="AvailableCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="当前可用" Style="{StaticResource Secondary}"/><TextBlock x:Name="AvailableText" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="含系统可复用的待机缓存" Style="{StaticResource Secondary}"/><Button Content="回收待机缓存" Click="Memory_Click" Style="{StaticResource Primary}"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource Card}" Padding="20,16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="后台常驻" FontWeight="SemiBold"/><TextBlock Text="关闭窗口后保留在托盘，不会自动清理。" Style="{StaticResource Secondary}"/></StackPanel><ToggleSwitch x:Name="DashboardResident" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="Resident_Toggled" AutomationProperties.Name="后台常驻"/></Grid></Border>
     <Grid x:Name="ActionCards" ColumnSpacing="16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="C 盘临时文件" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DiskSummary" Text="尚未扫描" FontSize="24"/><TextBlock Text="检查超过 7 天的临时文件，跳过占用和近期修改的文件。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描文件" Click="DiskScan_Click" Style="{StaticResource Primary}"/><Button Content="查看列表" Tag="disk" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
      <Border x:Name="RegistryCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="注册表启动项" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RegistrySummary" Text="尚未检查" FontSize="24"/><TextBlock Text="检查目标缺失的当前用户启动项，清理前备份，可恢复。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="检查启动项" Click="RegistryScan_Click" Style="{StaticResource Primary}"/><Button Content="查看列表" Tag="registry" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
      <Border x:Name="ProcessCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="进程占用" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProcessSummary" Text="扫描后查看内存占用较高的进程。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描进程" Click="Processes_Click" Style="{StaticResource Primary}"/><Button Content="查看完整列表" Tag="process" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
    <Grid x:Name="ProcessPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="工作集占用排行" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="低 CPU、无窗口不代表无用；不会自动结束进程。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描进程" Click="Processes_Click" Style="{StaticResource Primary}"/><Button Content="任务管理器" Click="TaskManager_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><ListView x:Name="Processes" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>
    <Grid x:Name="DiskPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="文件清理候选" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="仅当前用户 Temp 与 Windows Temp；删除不可撤销，请逐项核对路径。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重新扫描" Click="DiskScan_Click" Style="{StaticResource Primary}"/><Button Content="删除所选" Click="DiskClean_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><ListView x:Name="DiskList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>
    <Grid x:Name="RegistryPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="启动项清理候选" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="仅带引号的 C 盘 EXE 路径；目标缺失也可能是临时状态。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重新检查" Click="RegistryScan_Click" Style="{StaticResource Primary}"/><Button Content="备份并删除所选" Click="RegistryClean_Click"/><Button Content="从备份恢复" Click="Restore_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><ListView x:Name="RegistryList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" Padding="0,0,0,12">
     <TextBlock Text="外观与主题" FontSize="20" FontWeight="SemiBold"/>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="主题模式" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="24"><RadioButton x:Name="ThemeSystem" Content="跟随系统" Tag="System" GroupName="Theme" Checked="Theme_Checked"/><RadioButton x:Name="ThemeLight" Content="浅色" Tag="Light" GroupName="Theme" Checked="Theme_Checked" AutomationProperties.AutomationId="ThemeLight"/><RadioButton x:Name="ThemeDark" Content="深色" Tag="Dark" GroupName="Theme" Checked="Theme_Checked" AutomationProperties.AutomationId="ThemeDark"/></StackPanel><TextBlock Text="强调色" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="AccentChoice" Width="220" SelectionChanged="Appearance_Changed"><ComboBoxItem Content="鸢尾蓝" Tag="Indigo"/><ComboBoxItem Content="紫罗兰" Tag="Purple"/><ComboBoxItem Content="青绿色" Tag="Teal"/><ComboBoxItem Content="玫瑰色" Tag="Rose"/><ComboBoxItem Content="琥珀色" Tag="Amber"/></ComboBox><ToggleSwitch x:Name="MicaChoice" Header="云母背景" OnContent="开启" OffContent="纯色背景" Toggled="Appearance_Changed"/><TextBlock Text="外观即时生效，主窗口与 Mini 使用同一主题。" Style="{StaticResource Secondary}"/></StackPanel></Border>
     <TextBlock Text="窗口与运行" FontSize="20" FontWeight="SemiBold"/>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="20"><ToggleSwitch x:Name="Resident" Header="后台常驻" OnContent="关闭窗口后保留在托盘" OffContent="关闭主窗口时退出" Toggled="Resident_Toggled"/><ToggleSwitch x:Name="MiniTopChoice" Header="Mini 始终置顶" Toggled="Behavior_Changed"/><ToggleSwitch x:Name="StartMiniChoice" Header="启动时进入 Mini" Toggled="Behavior_Changed"/><StackPanel Spacing="8"><TextBlock Text="内存刷新间隔"/><ComboBox x:Name="RefreshChoice" Width="220" SelectionChanged="Behavior_Changed"><ComboBoxItem Content="2 秒" Tag="2"/><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="10 秒" Tag="10"/></ComboBox></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="ClearNest · 清巢" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="v0.2.0 · 所有清理均需手动确认" Style="{StaticResource Secondary}"/><Button Content="退出应用" Click="Exit_Click"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <InfoBar x:Name="Status" Grid.Row="1" IsOpen="True" IsClosable="False" Message="就绪 · 扫描不会自动删除"/>
   </Grid>
  </NavigationView>
 </Grid>
</Window>