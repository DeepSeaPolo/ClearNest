<Window x:Class="ClearNest.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ClearNest.Controls">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.Resources>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
   <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="Background" Value="{StaticResource AppAccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Grid.Resources>
  <Grid x:Name="TitleRegion" Background="Transparent" Padding="140,0,140,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Image x:Name="TitleAppIcon" Width="20" Height="20"/><TextBlock Text="ClearNest · 清巢" FontSize="13" VerticalAlignment="Center"/></StackPanel></Grid>
  <NavigationView Grid.Row="1" x:Name="Navigation" PaneDisplayMode="LeftCompact" CompactPaneLength="64" OpenPaneLength="208" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" Header="仪表盘">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="仪表盘" Tag="home" AutomationProperties.AutomationId="OpenHome"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="进程列表" Tag="process"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="临时文件" Tag="disk"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="启动项管理" Tag="registry"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" FontFamily="Segoe Fluent Icons"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems><NavigationViewItem Content="设置" Tag="settings" AutomationProperties.AutomationId="OpenSettings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE115;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
   <Grid Margin="24,4,24,20" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="HomePage" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DashboardStack" Spacing="16" Padding="0,0,0,8" SizeChanged="Dashboard_SizeChanged">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="查看状态，按需扫描，确认后清理。" Style="{StaticResource Secondary}" VerticalAlignment="Center"/><ToggleSwitch x:Name="DashboardResident" Grid.Column="1" OnContent="后台常驻" OffContent="后台常驻" Toggled="Resident_Toggled" AutomationProperties.Name="后台常驻" ToolTipService.ToolTip="关闭窗口后留在托盘，不会自动清理。"/><Button Grid.Column="2" Content="迷你模式" AutomationProperties.AutomationId="SwitchToMini" Click="Mini_Click" VerticalAlignment="Center"/></Grid>
     <Grid x:Name="MemoryCards" ColumnSpacing="16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="16"><StackPanel Spacing="6">
       <Grid><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE950;" FontSize="14"/><TextBlock Text="内存信息" FontWeight="SemiBold"/></StackPanel><Button Content="诊断" Click="Diagnostics_Click" HorizontalAlignment="Right" Margin="0,0,58,0" FontSize="12" Padding="8,4"/>
       <Button Content="回收" Click="Memory_Click" Style="{StaticResource Primary}" HorizontalAlignment="Right" FontSize="12" Padding="10,4" ToolTipService.ToolTip="仅回收待机缓存，不处理应用工作集"/></Grid>
       <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="MemoryUsedValue" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="MemoryPercent" FontSize="12" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel>
       <local:MemoryHistory x:Name="MemoryTrend" Height="48"/>
       <ProgressBar x:Name="MemoryBar" Maximum="100" Foreground="{StaticResource AppAccentBrush}"/>
       <Grid><TextBlock x:Name="UsedLegend" FontSize="12"/><TextBlock x:Name="AvailableText" FontSize="12" HorizontalAlignment="Right"/></Grid>
       <TextBlock x:Name="MemoryText" Visibility="Collapsed"/>
      </StackPanel></Border>
      <Border x:Name="AvailableCard" Grid.Column="1" Style="{StaticResource Card}" Padding="16"><StackPanel Spacing="10">
       <TextBlock Text="自动回收" FontSize="16" FontWeight="SemiBold"/>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ToggleSwitch x:Name="AutoInterval" OnContent="定时回收" OffContent="定时回收" AutomationProperties.Name="定时回收" Toggled="Automation_Toggled" AutomationProperties.AutomationId="AutoIntervalToggle"/><NumberBox x:Name="AutoMinutes" Grid.Column="1" Value="15" Minimum="5" Maximum="1440" SmallChange="5" SpinButtonPlacementMode="Compact" ValueChanged="AutomationNumber_Changed" VerticalAlignment="Bottom" AutomationProperties.Name="定时回收间隔分钟"/><TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ToggleSwitch x:Name="AutoThreshold" OnContent="高占用回收" OffContent="高占用回收" AutomationProperties.Name="高占用回收" Toggled="Automation_Toggled" AutomationProperties.AutomationId="AutoThresholdToggle"/><NumberBox x:Name="AutoPercent" Grid.Column="1" Value="85" Minimum="1" Maximum="99" SpinButtonPlacementMode="Compact" ValueChanged="AutomationNumber_Changed" VerticalAlignment="Bottom" AutomationProperties.Name="自动回收占用率阈值"/><TextBlock Grid.Column="2" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid>
       <TextBlock x:Name="AutoStateText" FontSize="12" Style="{StaticResource Secondary}"/>
       <TextBlock Text="仅处理待机缓存；两次回收至少间隔 5 分钟。阈值触发后，需下降 5 个百分点才会再次触发。" FontSize="11" Style="{StaticResource Secondary}"/>
      </StackPanel></Border>
     </Grid>
     <Grid x:Name="ActionCards" ColumnSpacing="16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="C 盘临时文件" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DiskSummary" Text="尚未扫描" FontSize="24"/><TextBlock Text="检查超过 7 天的临时文件，跳过占用和近期修改的文件。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描文件" Click="DiskScan_Click" Style="{StaticResource Primary}"/><Button Content="查看列表" Tag="disk" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
      <Border x:Name="RegistryCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="注册表启动项" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RegistrySummary" Text="尚未检查" FontSize="24"/><TextBlock Text="检查目标缺失的当前用户启动项，清理前备份，可恢复。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描启动项" Click="StartupScan_Click" Style="{StaticResource Primary}"/><Button Content="查看列表" Tag="registry" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
      <Border x:Name="ProcessCard" Grid.Column="2" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="进程占用" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ProcessSummary" Text="扫描后查看内存占用较高的进程。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描进程" AutomationProperties.AutomationId="ScanProcessHome" Click="Processes_Click" Style="{StaticResource Primary}"/><Button Content="查看完整列表" Tag="process" Click="OpenPage_Click"/></StackPanel></StackPanel></Border>
     </Grid>
    </StackPanel></ScrollViewer>
    <Grid x:Name="ProcessPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="进程资源排行" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="CPU 按全机逻辑处理器归一化；私有提交与工作集不是同一种内存指标。低 CPU 不代表无用。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重新采样" Click="Processes_Click" Style="{StaticResource Primary}"/><Button Content="文件位置" Click="ProcessLocation_Click"/><Button Content="任务管理器" Click="TaskManager_Click"/></StackPanel><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBox x:Name="ProcessSearch" PlaceholderText="搜索进程名、PID 或路径" TextChanged="ProcessFilter_Changed"/><ComboBox x:Name="ProcessSort" Grid.Column="1" SelectionChanged="ProcessSort_Changed"><ComboBoxItem Content="工作集占用"/><ComboBoxItem Content="CPU 占用"/><ComboBoxItem Content="私有提交"/></ComboBox></Grid></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><ListView x:Name="Processes" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border></Grid>
    <Grid x:Name="DiskPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="文件清理候选" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="保留最近 7 天文件；删除不经过回收站，仅删除当前页所选项目。" Style="{StaticResource Secondary}"/><CheckBox x:Name="IncludeAppCaches" Content="包含已知应用缓存（Discord、Slack、经典 Teams）"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重新扫描" Click="DiskScan_Click" Style="{StaticResource Primary}"/><Button Content="删除当前页所选" Click="DiskClean_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><ListView x:Name="DiskList" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Border><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><Button Content="上一页" Click="DiskPrevious_Click"/><TextBlock x:Name="DiskPageText" VerticalAlignment="Center" Text="尚未扫描"/><Button Content="下一页" Click="DiskNext_Click"/></StackPanel></Grid>
    <Grid x:Name="RegistryPage" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="启动项与失效项" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="当前用户 Run 项可停用并恢复。机器级和启动文件夹只读；Windows 的最终启停状态请在系统设置确认。" Style="{StaticResource Secondary}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="扫描启动项" Click="StartupScan_Click" Style="{StaticResource Primary}"/><Button Content="停用选中" Click="StartupDisable_Click"/><Button Content="恢复选中" Click="StartupEnable_Click"/><Button Content="系统启动设置" Click="SystemStartup_Click"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="检查缺失目标" Click="RegistryScan_Click"/><Button Content="备份并删除所选失效项" Click="RegistryClean_Click"/><Button Content="从备份恢复" Click="Restore_Click"/></StackPanel></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><Grid><ListView x:Name="StartupList" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView><ListView x:Name="RegistryList" Visibility="Collapsed" SelectionMode="Multiple"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" Padding="4,8"/></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" Padding="0,0,0,12">
     <TextBlock Text="外观与主题" FontSize="20" FontWeight="SemiBold"/>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="主题模式" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="24"><RadioButton x:Name="ThemeSystem" Content="跟随系统" Tag="System" GroupName="Theme" Checked="Theme_Checked"/><RadioButton x:Name="ThemeLight" Content="浅色" Tag="Light" GroupName="Theme" Checked="Theme_Checked" AutomationProperties.AutomationId="ThemeLight"/><RadioButton x:Name="ThemeDark" Content="深色" Tag="Dark" GroupName="Theme" Checked="Theme_Checked" AutomationProperties.AutomationId="ThemeDark"/></StackPanel><TextBlock Text="强调色" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="AccentChoice" Width="220" SelectionChanged="Appearance_Changed"><ComboBoxItem Content="鸢尾蓝" Tag="Indigo"/><ComboBoxItem Content="紫罗兰" Tag="Purple"/><ComboBoxItem Content="青绿色" Tag="Teal"/><ComboBoxItem Content="玫瑰色" Tag="Rose"/><ComboBoxItem Content="琥珀色" Tag="Amber"/></ComboBox><ToggleSwitch x:Name="MicaChoice" Header="云母背景" OnContent="开启" OffContent="纯色背景" Toggled="Appearance_Changed"/><TextBlock Text="外观即时生效，主窗口与 Mini 使用同一主题。" Style="{StaticResource Secondary}"/></StackPanel></Border>
     <TextBlock Text="窗口与运行" FontSize="20" FontWeight="SemiBold"/>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="20"><ToggleSwitch x:Name="Resident" Header="后台常驻" OnContent="关闭窗口后保留在托盘" OffContent="关闭主窗口时退出" Toggled="Resident_Toggled"/><ToggleSwitch x:Name="MiniTopChoice" Header="Mini 始终置顶" Toggled="Behavior_Changed"/><ToggleSwitch x:Name="StartMiniChoice" Header="启动时进入 Mini" Toggled="Behavior_Changed"/><StackPanel Spacing="8"><TextBlock Text="内存刷新间隔"/><ComboBox x:Name="RefreshChoice" Width="220" SelectionChanged="Behavior_Changed"><ComboBoxItem Content="2 秒" Tag="2"/><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="10 秒" Tag="10"/></ComboBox></StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel Spacing="8"><TextBlock Text="ClearNest · 清巢" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="v0.4.0 · 文件与启动项清理仍需确认" Style="{StaticResource Secondary}"/><Button Content="退出应用" Click="Exit_Click"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Spacing="8"><Grid x:Name="OperationBar" Visibility="Collapsed" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressRing Width="20" Height="20" IsActive="True"/><TextBlock x:Name="OperationText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelOperation" Grid.Column="2" Content="取消任务" Click="CancelOperation_Click" AutomationProperties.AutomationId="CancelOperation"/></Grid><InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Message="就绪 · 扫描不会自动删除"/></StackPanel>
   </Grid>
  </NavigationView>
 </Grid>
</Window>